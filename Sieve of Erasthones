 /// sieve of erasthones - for all prime numbers till n
 
 public static int [] bettersieve(int n ){

    boolean isprime [] = new boolean[n+1];

    Arrays.fill(isprime, true );
     isprime [0] = false;
     isprime [1] = false;

     for(int i = 2; i * i<= n ;i++){
        if(isprime[i]){
        for(int j = i*i; j<=n ;j+=i){
              isprime[j] = false;        }
        }
     }

       int count = 0;
    for (int i = 2; i <= n; i++) {
        if (isprime[i]) count++;
    }

    // store primes
    int[] primes = new int[count];
    int idx = 0;
    for (int i = 2; i <= n; i++) {
        if (isprime[i]) {
            primes[idx++] = i;
        }
    }

    return primes;
 }
